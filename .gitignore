# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Secrets / config (NEVER commit) ────────────────────────────────
.env
.env.*
!.env.example
.bd-os.yaml
.bd-os.yaml.*
*.key
*.pem
secrets.yaml
secrets.json

# ─── Vault data (per-user, never commit) ────────────────────────────
.cache/
checkpoints/
*.db
*.sqlite
*.sqlite3

# ─── Generated outputs (binary docs) ────────────────────────────────
*.docx
*.xlsx
*.pdf
!templates-us/**/*.docx
!templates-us/**/*.xlsx
!templates-us/**/*.pdf

# ─── Logs ───────────────────────────────────────────────────────────
*.log
.bd-business-os.log

# ─── IDE / Editor ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude / Session state ─────────────────────────────────────────
.claude/session-state/
.claude/projects/

# ─── External references (read-only, not vendored) ──────────────────
references/tradingagents/
references/

# ─── User experiments / scratch ─────────────────────────────────────
scratch/
playground/
TODO.private.md

# Local Claude Code settings
.claude/settings.local.json
.bd-usage.jsonl
00-Dashboard.md

# Obsidian app config (contains Local REST API bearer key) — never commit
.obsidian/

# ─── Office lock files + generated decks ────────────────────────────
~$*
*.pptx
!templates-us/**/*.pptx
.tools/
.bd-llm-events.jsonl
.bd-agent-activity.jsonl


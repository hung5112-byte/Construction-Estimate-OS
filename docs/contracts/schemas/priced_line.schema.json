    "labor": {
      "type": "number"
    },
    "material": {
      "type": "number"
    },
    "equipment": {
      "type": "number"
    },
    "sub": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "source": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "method": {
      "type": "string"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-estimate-os/contracts/v1/gate.schema.json",
  "type": "object",
  "title": "Review gate result",
  "required": [
    "id",
    "name",
    "passed",
    "blocking",
    "details"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "blocking": {
      "type": "boolean"
    },
    "details": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

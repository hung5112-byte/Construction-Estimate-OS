# Construction-Estimate-OS — API keys template (none are needed for the deterministic pipeline)
# Copy this file to <vault>/.env and fill in the real keys.
# The .env file is already gitignored — NEVER commit it to git.

# Tavily — search law/competitors/web (free tier 1000 req/month at https://tavily.com)
TAVILY_API_KEY=

# Anthropic — only needed if NOT using MCP sampling via Claude Desktop
# When running via the Claude Desktop subscription, SKIP this key
ANTHROPIC_API_KEY=

# Google Gemini — fallback LLM (optional)
GOOGLE_API_KEY=

# OpenAI GPT — fallback LLM (optional)
OPENAI_API_KEY=

# Brave Search — alternative search (future, optional)
BRAVE_API_KEY=
